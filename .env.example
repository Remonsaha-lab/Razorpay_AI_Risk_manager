# DisputeGuard — Unified Environment Variables Template
# Copy this file to .env for local full-stack development, or configure
# individual variables in Render and Vercel project dashboards.
# IMPORTANT: .env is ignored by git — never commit production secrets.

# ── LLM & AI Narrative Generation (Optional) ────────────────────────
# Google Gemini API key for evidence-grounded representment narratives.
# If omitted or invalid, DisputeGuard automatically falls back to deterministic rule-based narratives.
GEMINI_API_KEY=

# ── Application Environment ──────────────────────────────────────────
# Options: development, production, test
ENVIRONMENT=development

# ── Backend Configuration (Render / Local) ───────────────────────────
# Server host and port configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Dynamic port assigned by Render in production (accessible via $PORT)
PORT=8000

# Cross-Origin Resource Sharing (CORS)
# Comma-separated list of allowed origins (e.g. local frontend or custom production domain)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://disputeguard.vercel.app

# Regular expression matching Vercel preview & production deployment URLs
ALLOWED_ORIGIN_REGEX=^https://.*\.vercel\.app$

# ── Frontend Configuration (Vercel / Local) ──────────────────────────
# URL of the backend API used by the Next.js client
# In local development: http://localhost:8000
# In production on Vercel: set to your deployed Render service URL (e.g. https://disputeguard-backend.onrender.com)
NEXT_PUBLIC_API_URL=http://localhost:8000
