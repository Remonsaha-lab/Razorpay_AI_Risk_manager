# DisputeGuard — Environment Variables
# Copy this file to .env and fill in your values
# IMPORTANT: .env is in .gitignore — never commit your API keys

# ── LLM (Optional) ────────────────────────────────────────────────
# Used for AI representment narrative generation (Gemini 1.5 Pro)
# Falls back to a deterministic rule-based template if not set.
GEMINI_API_KEY=

# ── Backend ───────────────────────────────────────────────────────
# FastAPI server settings (defaults used if not set)
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ── Frontend ──────────────────────────────────────────────────────
# Must match the backend URL (used by Next.js API client)
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Environment ───────────────────────────────────────────────────
ENVIRONMENT=development
