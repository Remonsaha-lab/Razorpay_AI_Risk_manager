# DisputeGuard Backend — Environment Variables
# Copy this file to .env or configure in Render dashboard

# ── Server & Port Configuration ───────────────────────────────────
# Server host binding (0.0.0.0 for container / Render production)
BACKEND_HOST=0.0.0.0
# Default local port
BACKEND_PORT=8000
# Dynamic port assigned by Render ($PORT)
PORT=8000
# Environment: development, production, test
ENVIRONMENT=production

# ── Cross-Origin Resource Sharing (CORS) ─────────────────────────
# Comma-separated list of additional allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://disputeguard.vercel.app

# Regular expression to match preview and production Vercel deployment URLs
ALLOWED_ORIGIN_REGEX=^https://.*\.vercel\.app$

# ── Optional LLM Configuration ───────────────────────────────────
# Google Gemini API key for AI narrative generation
# If unset, DisputeGuard automatically falls back to deterministic rule-based narratives
GEMINI_API_KEY=
